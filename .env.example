# Create these at https://my.telegram.org/apps
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=replace-with-your-api-hash

# Source is the private chat where the alert bot sends messages.
TELEGRAM_SOURCE_CHAT=@source_alert_bot

# Routed targets.
# Messages starting with "Price spikes" go to TELEGRAM_PRICE_SPIKES_TARGET_CHAT.
# All other messages go to TELEGRAM_NEW_ENTRIES_TARGET_CHAT.
TELEGRAM_PRICE_SPIKES_TARGET_CHAT=-1001111111111
TELEGRAM_NEW_ENTRIES_TARGET_CHAT=-1002222222222

# Optional legacy fallback. Leave empty when both routed targets are set.
TELEGRAM_TARGET_CHAT=
TELEGRAM_FORWARD_MODE=copy
TELEGRAM_SESSION=telegram_forwarder
