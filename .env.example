# Create these at https://my.telegram.org/apps
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=replace-with-your-api-hash

# Source is the private chat where the alert bot sends messages.
TELEGRAM_SOURCE_CHAT=@source_alert_bot

# Common forum-enabled target group.
TELEGRAM_TARGET_CHAT=-1001234567890

# Routed topics inside TELEGRAM_TARGET_CHAT.
# Messages starting with "Price spikes" go to TELEGRAM_PRICE_SPIKES_TOPIC_ID.
# All other messages go to TELEGRAM_NEW_ENTRIES_TOPIC_ID.
TELEGRAM_PRICE_SPIKES_TOPIC_ID=111
TELEGRAM_NEW_ENTRIES_TOPIC_ID=222

# Optional: use different target chats instead of TELEGRAM_TARGET_CHAT.
TELEGRAM_PRICE_SPIKES_TARGET_CHAT=
TELEGRAM_NEW_ENTRIES_TARGET_CHAT=

TELEGRAM_FORWARD_MODE=copy
TELEGRAM_SESSION=telegram_forwarder
